  <script>
    // ------ Simple demo model (purely statistical + random noise) ------
    // This model is intentionally simple: it uses recent history (if provided) to compute
    // mean multiplier, volatility, and from that produces 'HIGH/LOW/SKIP' style signals.
    // This is for entertainment only.

    const predLabelEl = document.getElementById('predLabel');
    const predReasonEl = document.getElementById('predReason');
    const predConfEl = document.getElementById('predConf');
    const meterFill = document.getElementById('meterFill');
    const logEl = document.getElementById('log');
    const lastResultEl = document.getElementById('lastResult');
    const lastConfEl = document.getElementById('lastConf');
    const sessionStatsEl = document.getElementById('sessionStats');

    let intervalId = null;
    let running = false;
    let session = {count:0,hits:0};

    function appendLog(html){
      const d = document.createElement('div');
      d.className = 'entry';
      d.innerHTML = html;
      logEl.prepend(d);
    }

    function parseHistory(input){
      if(!input) return [];
      // accept numbers (multipliers) e.g. 1.2 2 3.4 or free text - extract floats
      const nums = input.match(/\d+(?:\.\d+)?/g);
      if(!nums) return [];
      return nums.map(n=>parseFloat(n)).filter(n=>!isNaN(n));
    }

    function computeStats(arr){
      if(!arr || arr.length===0) return null;
      const n = arr.length;
      const mean = arr.reduce((s,x)=>s+x,0)/n;
      const variance = arr.reduce((s,x)=>s+Math.pow(x-mean,2),0)/n;
      const std = Math.sqrt(variance);
      const median = arr.slice().sort((a,b)=>a-b)[Math.floor(n/2)];
      const last = arr[arr.length-1];
      return {n,mean,std,median,last};
    }

    function makePrediction(historyArr, mode='auto'){
      // Return {label, confidence (0-100), reason}
      // labels: BET_HIGH (go for multiplier > 2x), BET_LOW (cash out early), SKIP
      // crude heuristics:
      const base = {label:'SKIP',confidence:30,reason:'Insufficient data — default SKIP'};
      if(!historyArr || historyArr.length<1) return base;
      const s = computeStats(historyArr);
      let conf = Math.min(90, Math.max(12, Math.round(50 + (s.mean-1.3)*15 - s.std*6 + (s.n-5)*1)));
      // apply mode
      if(mode==='aggr') conf = Math.min(98, conf + 8);
      if(mode==='conservative') conf = Math.max(10, conf - 10);

      // simple rule: if mean is high and volatility moderate -> BET_HIGH
      if(s.mean >= 2.2 && s.std < s.mean*0.8){
        return {label:'BET HIGH', confidence: Math.round(conf + 10), reason:`mean ${s.mean.toFixed(2)}, std ${s.std.toFixed(2)} — Favor higher multipliers`};
      }
      // if mean low but last had spike -> maybe SKIP or BET_LOW
      if(s.mean < 1.6){
        return {label:'BET LOW', confidence: Math.round(conf - 5), reason:`mean ${s.mean.toFixed(2)} — conservative: prefer low bets or early cashouts`};
      }
      // if mean moderate and volatility low -> opportunistic
      if(s.mean>=1.6 && s.mean<2.2 && s.std < 0.6){
        return {label:'BET HIGH (opportunistic)', confidence: Math.round(conf), reason:`mean ${s.mean.toFixed(2)}, low volatility`};
      }
      // fallback random-ish but weighted by mean
      const rand = Math.random();
      if(rand < Math.min(0.35, Math.max(0.05, (2.0 - s.mean)/2))){
        return {label:'SKIP', confidence: Math.round(conf-10), reason:`Randomized skip (mean ${s.mean.toFixed(2)})`};
      }
      return {label:'BET LOW', confidence: Math.round(conf-2), reason:`Default fallback — mean ${s.mean.toFixed(2)}`};
    }

    function showThinking(){
      predLabelEl.textContent = 'AI is thinking';
      predReasonEl.innerHTML = '<span class="thinking"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>';
    }

    function renderPrediction(pred){
      predLabelEl.textContent = pred.label;
      predReasonEl.textContent = pred.reason;
      predConfEl.textContent = pred.confidence + '%';
      meterFill.style.width = Math.max(4, Math.min(100, pred.confidence)) + '%';
    }

    function generateAndDisplayOne(mode){
      const raw = document.getElementById('historyInput').value;
      const arr = parseHistory(raw);
      const pred = makePrediction(arr, mode);
      renderPrediction(pred);
      appendLog(`<strong>Prediction:</strong> ${pred.label} — ${pred.confidence}% — ${pred.reason}`);
      lastResultEl.textContent = pred.label;
      lastConfEl.textContent = pred.confidence + '%';
      session.count += 1;
      sessionStatsEl.textContent = `Predictions: ${session.count} | Hits: ${session.hits} (simulated)`;
    }

    // CONTROL / INTERVAL
    document.getElementById('startBtn').addEventListener('click', ()=>{
      if(running) return;
      const secs = Math.max(1, parseInt(document.getElementById('intervalInput').value || 4));
      const mode = document.getElementById('aggrMode').value;
      running = true;
      appendLog('<strong>System:</strong> Live session started');
      // immediate one
      showThinking();
      setTimeout(()=>{ generateAndDisplayOne(mode); }, 900 + Math.random()*800);
      intervalId = setInterval(()=>{
        showThinking();
        // thinking time before reveal
        setTimeout(()=>{ generateAndDisplayOne(mode); }, 900 + Math.random()*800);
      }, secs*1000);
    });

    document.getElementById('stopBtn').addEventListener('click', ()=>{
      if(intervalId) clearInterval(intervalId);
      intervalId = null; running = false;
      appendLog('<strong>System:</strong> Live session stopped');
    });

    document.getElementById('oneShotBtn').addEventListener('click', ()=>{
      const mode = document.getElementById('aggrMode').value;
      showThinking();
      setTimeout(()=>{ generateAndDisplayOne(mode); }, 900 + Math.random()*800);
    });

    document.getElementById('resetHistory').addEventListener('click', ()=>{
      document.getElementById('historyInput').value = '';
      appendLog('<strong>System:</strong> History cleared');
    });

    // Copy HTML to clipboard (helps quick deploy)
    document.getElementById('copyBtn').addEventListener('click', async ()=>{
      try{
        const html = document.documentElement.outerHTML;
        await navigator.clipboard.writeText('<!doctype html>\n' + html);
        appendLog('<strong>System:</strong> HTML copied to clipboard — paste into a new file on Netlify/GitHub Pages');
      }catch(e){
        appendLog('<strong>System:</strong> Copy failed — your browser may block clipboard access');
      }
    });

    // Download .html file
    document.getElementById('downloadBtn').addEventListener('click', ()=>{
      const html = '<!doctype html>\n' + document.documentElement.outerHTML;
      const blob = new Blob([html], {type: 'text/html'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = '1win-predictor-demo.html';
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
      appendLog('<strong>System:</strong> Download started — save the file and upload to GitHub or Netlify');
    });

    // basic safety: prevent realtime autoplay if on mobile data? just log
    // initialise
    appendLog('<strong>System:</strong> UI ready. Enter history or start live demo.');
  </script>
